---
import Hero from '../components/blocks/Hero.astro'
import PageSections from '../components/blocks/PageSections.astro'
import SharedContent from '../components/blocks/SharedContent.astro'
import SiteLayout from '../layouts/site.astro'
import {getHomePage} from '../lib/pages'
import {getEventsForSite, getListingsForSite} from '../lib/shared-content'
import {getSiteBrand} from '../lib/site'

const brand = getSiteBrand()
const page = await getHomePage()
const events = await getEventsForSite()
const listings = await getListingsForSite()

if (!page) {
  throw new Error(`Home page not found for site: ${brand.slug}`)
}
---

<SiteLayout title={page.title} description={page.hero.subheadline}>
  <Hero hero={page.hero} />
  <PageSections sections={page.sections} />
  <SharedContent {events} {listings} />
</SiteLayout>
