---
import type {CelestialBody} from '../lib/sanity'
import {formatBodyType, formatMass, urlFor} from '../lib/sanity'

interface Props {
  body: CelestialBody
}

const {body} = Astro.props
const mass = formatMass(body.mass)
const image = body.images?.[0]
const imageUrl = image?.asset ? urlFor(image).width(640).height(360).fit('crop').auto('format').url() : undefined
---

<article class="flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg shadow-black/20 backdrop-blur">
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={image?.alt ?? body.name}
        class="aspect-video w-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="flex aspect-video items-center justify-center bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950">
        <span class="text-5xl" aria-hidden="true">
          {body.bodyType === 'star' ? '☀️' : body.bodyType === 'moon' ? '🌙' : '🪐'}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-xl font-semibold text-white">{body.name}</h2>
        <p class="mt-1 text-sm text-indigo-300">{formatBodyType(body.bodyType)}</p>
      </div>
      {
        mass && (
          <p class="rounded-full bg-slate-800 px-3 py-1 text-xs font-medium text-slate-200">{mass}</p>
        )
      }
    </div>

    {
      body.facts && body.facts.length > 0 && (
        <dl class="grid gap-2 text-sm">
          {
            body.facts.map((fact) => (
              <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-3 border-t border-slate-800 pt-2 first:border-t-0 first:pt-0">
                <dt class="text-slate-400">{fact.label}</dt>
                <dd class="text-right text-slate-100">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      )
    }
  </div>
</article>
