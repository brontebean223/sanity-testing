# Sanity (same project for all site deployments)
PUBLIC_SANITY_PROJECT_ID=rhhpqw8l
PUBLIC_SANITY_DATASET=production

# Which hotel this deployment represents (must match a site slug in Sanity Studio)
PUBLIC_SITE_SLUG=grand-harbor-hotel

# Cloudinary credentials are configured in Studio on first use (stored in the dataset).
# No frontend env vars required — image URLs come from stored cloudinary.asset data.

# --- Local URLs ---
# Option A — one command, both hotels:
#   npm run dev:web:both
#
# Option B — two terminals:
#   npm run dev:web          → http://localhost:4321  (Grand Harbor)
#   npm run dev:web:sister   → http://localhost:4322  (Harbor Light)
#
# 4322 only works while dev:web:sister (or dev:web:both) is running.
#   127.0.0.1 grand-harbor.local
#   127.0.0.1 harbor-light.local
# Grand Harbor:  http://grand-harbor.local:4321
# Harbor Light:  http://harbor-light.local:4322
#
# --- Vercel (one project per hotel, same repo) ---
# Copy this file to .env.local for local dev only.
# On Vercel, set the same variables in each project's Environment Variables UI.
#
# Project "grand-harbor-web":
#   PUBLIC_SITE_SLUG=grand-harbor-hotel
#
# Project "harbor-light-web":
#   PUBLIC_SITE_SLUG=harbor-light-inn
#
# Both projects also need PUBLIC_SANITY_PROJECT_ID and PUBLIC_SANITY_DATASET.
# Each gets its own *.vercel.app URL; add custom domains (grandharbor.com etc.) later.
